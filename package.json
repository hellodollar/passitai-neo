{
  "name": "passitai-neo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "type-check": "vue-tsc --build",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint . && eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "oxfmt .",
    "check": "pnpm type-check && pnpm test && pnpm lint && pnpm format --check"
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0",
    "date-fns": "^4.4.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.6.1",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  }
}
