{
  "name": "passitai-neo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "type-check": "vue-tsc --build",
    "test": "node --test tests/*.test.mjs",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:check": "run-s lint:oxlint:check lint:eslint:check",
    "lint:oxlint": "oxlint . --fix",
    "lint:oxlint:check": "oxlint .",
    "lint:eslint": "eslint . --fix --cache",
    "lint:eslint:check": "eslint . --cache",
    "format": "oxfmt src/ vite.config.ts eslint.config.ts env.d.ts",
    "format:check": "oxfmt --check src/ vite.config.ts eslint.config.ts env.d.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.66.0",
    "@vue/devtools-api": "^8.2.1",
    "date-fns": "^4.4.0",
    "ofetch": "^1.5.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "26.13.0"
  }
}
