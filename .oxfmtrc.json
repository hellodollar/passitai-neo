{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": ["src/generated/**", "docs/client-api.md", "pnpm-lock.yaml"],
  "overrides": [
    {
      "files": ["**/*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
